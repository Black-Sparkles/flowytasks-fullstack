POSTGRES_DB=flowytasks
POSTGRES_USER=flowytasks
POSTGRES_PASSWORD=replace_with_a_private_local_password

# Generate a 32-byte random value and Base64 encode it.
# Example commands:
# PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# OpenSSL:
# openssl rand -base64 32
JWT_SECRET=replace_with_a_base64_encoded_256_bit_secret
